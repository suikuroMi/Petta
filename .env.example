# Leave DATABASE_URL unset for local SQLite development (data/petta.db).
# Set DATABASE_URL to your Render PostgreSQL External/Internal connection string for Postgres.
DATABASE_URL=postgresql://user:password@host:5432/petta_db

# Hosted Petta Qwen2.5-3B LoRA inference URL (from ai/serve_petta_colab.ipynb Cloudflare Tunnel)
PETTA_AI_URL=https://your-tunnel.trycloudflare.com
PETTA_AI_SECRET=
